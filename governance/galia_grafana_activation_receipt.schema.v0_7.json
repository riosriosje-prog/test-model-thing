{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "galia-grafana-activation-receipt-v0.7",
  "title": "GALIA Grafana JIT Activation Receipt v0.7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_type",
    "project_ref",
    "activation_contract_candidate_id",
    "activation_contract_head",
    "activation_contract_candidate_set_sha256",
    "activation_complete",
    "credential_mode",
    "postgres_role",
    "gotrue_id",
    "service_pat_belongs_to_gotrue_id_verified",
    "scoped_pat_available",
    "ssl_enforcement_enabled",
    "temporary_access_enabled",
    "jit_mapping_verified",
    "network_profile",
    "source_cidrs",
    "direct_ipv6_reachability_verified",
    "pdc_agent_network_verified",
    "server_root_ca_sha256",
    "expires_at",
    "direct_verify_full_connection_passed",
    "secret_material_persisted",
    "primary_email_persisted"
