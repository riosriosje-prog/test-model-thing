{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "galia-grafana-activation-receipt-v0.8",
  "title": "GALIA Grafana JIT Activation Receipt v0.8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_type",
    "project_ref",
    "activation_contract_candidate_id",
    "activation_contract_head",
    "activation_contract_candidate_set_sha256",
    "activation_complete",
    "credential_mode",
    "postgres_role",
    "gotrue_id",
    "service_pat_belongs_to_gotrue_id_verified",
    "scoped_pat_available",
    "ssl_enforcement_enabled",
    "temporary_access_enabled",
    "jit_mapping_verified",
    "network_profile",
    "source_cidrs",
    "self_hosted_direct_ipv6_reachability_verified",
    "pdc_agent_ipv6_reachability_verified",
    "route_verification_method",
    "server_root_ca_sha256",
    "expires_at",
    "tls_verification_method",
    "verify_full_connection_passed",
    "secret_material_persisted",
    "primary_email_persisted"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "receipt_type": {
      "const": "GALIA_GRAFANA_JIT_ACTIVATION_RECEIPT"
    },
    "project_ref": {
      "const": "nzoviwitcqmsacwiizhh"
    },
    "activation_contract_candidate_id": {
      "const": "GALIA-GRAFANA-JIT-ACTIVATION-CANDIDATE-v0.6"
    },
    "activation_contract_head": {
      "const": "d0c71aaf76333a7f6b8542e2b48b01cfa0ad6654"
    },
    "activation_contract_candidate_set_sha256": {
      "const": "1b0d25ca98a59182ade20d868f371655c7bd86d625d9c8dbd1961f896d5d73c2"
    },
    "activation_complete": {
      "const": true
    },
    "credential_mode": {
      "const": "TEMPORARY_ACCESS_JIT_DIRECT"
    },
    "postgres_role": {
      "const": "galia_grafana_ro"
    },
    "gotrue_id": {
      "type": "string",
      "format": "uuid"
    },
    "service_pat_belongs_to_gotrue_id_verified": {
      "const": true
    },
    "scoped_pat_available": {
      "const": true
    },
    "ssl_enforcement_enabled": {
      "const": true
    },
    "temporary_access_enabled": {
      "const": true
    },
    "jit_mapping_verified": {
      "const": true
    },
    "network_profile": {
      "enum": [
        "SELF_HOSTED_IPV6",
        "GRAFANA_CLOUD_PDC_IPV6"
      ]
    },
    "source_cidrs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "self_hosted_direct_ipv6_reachability_verified": {
      "type": "boolean"
    },
    "pdc_agent_ipv6_reachability_verified": {
      "type": "boolean"
    },
    "route_verification_method": {
      "enum": [
        "SELF_HOSTED_DIRECT_IPV6",
        "PDC_AGENT_IPV6"
      ]
    },
    "server_root_ca_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1
    },
    "tls_verification_method": {
      "enum": [
        "SELF_HOSTED_PSQL_VERIFY_FULL",
        "GRAFANA_PDC_SAVE_AND_TEST_VERIFY_FULL"
      ]
    },
    "verify_full_connection_passed": {
      "const": true
    },
    "secret_material_persisted": {
      "const": false
    },
    "primary_email_persisted": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "network_profile": {
            "const": "SELF_HOSTED_IPV6"
          }
        },
        "required": [
          "network_profile"
        ]
      },
      "then": {
        "properties": {
          "self_hosted_direct_ipv6_reachability_verified": {
            "const": true
          },
          "pdc_agent_ipv6_reachability_verified": {
            "const": false
          },
          "route_verification_method": {
            "const": "SELF_HOSTED_DIRECT_IPV6"
          },
          "tls_verification_method": {
            "const": "SELF_HOSTED_PSQL_VERIFY_FULL"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "network_profile": {
            "const": "GRAFANA_CLOUD_PDC_IPV6"
          }
        },
        "required": [
          "network_profile"
        ]
      },
      "then": {
        "properties": {
          "self_hosted_direct_ipv6_reachability_verified": {
            "const": false
          },
          "pdc_agent_ipv6_reachability_verified": {
            "const": true
          },
          "route_verification_method": {
            "const": "PDC_AGENT_IPV6"
          },
          "tls_verification_method": {
            "const": "GRAFANA_PDC_SAVE_AND_TEST_VERIFY_FULL"
          }
        }
      }
    }
  ]
}
