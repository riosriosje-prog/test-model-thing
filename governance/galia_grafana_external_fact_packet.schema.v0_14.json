    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_binding",
        "grafana_stack_identity",
        "pdc_network_identity",
        "pdc_connected_agent_state",
        "pdc_ipv6_route_to_supabase",
        "credential_availability_and_domain_separation",
        "supabase_ssl_state",
        "supabase_temporary_access_state",
        "supabase_jit_mapping_state",
