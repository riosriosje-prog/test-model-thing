      "format": "date-time"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ratification_merge",
        "pdc_contract_candidate_id",
        "pdc_contract_head",
        "pdc_contract_candidate_set_sha256"
