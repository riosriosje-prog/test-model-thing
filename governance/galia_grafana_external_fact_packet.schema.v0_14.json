          "const": "GALIA-GRAFANA-PDC-OFFICIAL-BINDING-CONTRACT-CANDIDATE-v0.11"
        },
        "pdc_contract_head": {
          "const": "ce4d638f11d5e63461ec5a2bd99155146c806ec4"
        },
        "pdc_contract_candidate_set_sha256": {
          "const": "ea5988231b7585dd6124722520483f258b34e39592de535a251c7bbc7d0296fc"
        }
      }
    },
    "profile": {
      "const": "GRAFANA_CLOUD_PDC_IPV6"
