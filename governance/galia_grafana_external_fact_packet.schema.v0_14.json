  "$defs": {
    "evidence_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at_utc",
        "method",
        "source_ref",
        "receipt_sha256"
      ],
      "properties": {
        "observed_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
