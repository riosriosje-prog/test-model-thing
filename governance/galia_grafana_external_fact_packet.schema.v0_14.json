      "required": [
        "stack_url",
        "stack_id",
        "pdc_network"
      ],
      "properties": {
        "stack_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "stack_id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "pdc_network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "region",
            "status",
            "discovery_source",
            "connected_agents_count"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "region": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "minLength": 1
            },
            "discovery_source": {
              "const": "GRAFANA_CLOUD_OFFICIAL_SURFACE"
            },
            "connected_agents_count": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grafana_cloud_access_policy_credential_available",
        "grafana_stack_service_account_credential_available",
